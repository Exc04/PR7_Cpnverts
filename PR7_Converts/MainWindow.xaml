<Window x:Class="PR7_Converts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR7_Converts"
        xmlns:models="clr-namespace:PR7_Converts.Models"
        xmlns:converters="clr-namespace:PR7_Converts.Converters"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <models:Deposit x:Key="deposit"/>
        <converters:RateConverter x:Key="rateConverter"/>
        <converters:IncomeColorConverter x:Key="incomeColorConverter"/>
    </Window.Resources>

    <Window.DataContext>
        <Binding Source="{StaticResource deposit}"/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="5">
            <StackPanel>
                <Label>Клиент</Label>
                <TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel>
                <Label>Сумма вклада</Label>
                <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel>
                <Label>Годовая ставка (в %)</Label>
                <TextBox Text="{Binding AnnualRate, Converter={StaticResource rateConverter}, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel>
                <Label>Срок (мес.)</Label>
                <TextBox Text="{Binding Months, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="5">
            <StackPanel>
                <Label>Клиент:</Label>
                <TextBlock Text="{Binding ClientName}"/>
            </StackPanel>
            <StackPanel>
                <Label>Сумма вклада:</Label>
                <TextBlock Text="{Binding Amount, StringFormat={}{0:C}, ConverterCulture=ru-RU}"/>
            </StackPanel>
            <StackPanel>
                <Label>Годовая ставка:</Label>
                <TextBlock Text="{Binding AnnualRate, StringFormat={}{0:P0}}"/>
            </StackPanel>
            <StackPanel>
                <Label>Срок:</Label>
                <TextBlock Text="{Binding Months, StringFormat={}{0} мес.}"/>
            </StackPanel>
            <StackPanel>
                <Label>Доход:</Label>
                <TextBlock Text="{Binding Income, StringFormat={}{0:C}, ConverterCulture=ru-RU}"
                           Foreground="{Binding Income, Converter={StaticResource incomeColorConverter}}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>